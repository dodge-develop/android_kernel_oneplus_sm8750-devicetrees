&pmk8550_vadc {
	pm8550_gpio02_therm {
		reg = <PM8550_ADC5_GEN3_AMUX_THM6_GPIO2_100K_PU>;
		label = "pm8550_gpio02_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm-type = <1>;
	};

};

&thermal_zones {
	pm8550_gpio02_usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pmk8550_vadc PM8550_ADC5_GEN3_AMUX_THM6_GPIO2_100K_PU>;
		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	/*
	 * Skin-temp CPU/GPU mitigation ladder on xo-therm, standing in for
	 * the OOS ThermalService freq caps absent on AOSP. step_wise walks
	 * cdev states within each range while the trip is exceeded; the
	 * ranges deepen tier by tier so heavier loads always have mitigation
	 * left rather than pinning at a ceiling. Upper bounds stop short of
	 * cdev max (cpufreq 15, kgsl 13) to keep the device usable when hot.
	 */
	sys-therm-0 {
		trips {
			skin_warm_trip: skin-warm {
				temperature = <46000>;
				hysteresis = <3000>;
				type = "passive";
			};

			skin_hot_trip: skin-hot {
				temperature = <49000>;
				hysteresis = <3000>;
				type = "passive";
			};

			skin_crit_trip: skin-crit {
				temperature = <52000>;
				hysteresis = <4000>;
				type = "passive";
			};
		};

		cooling-maps {
			skin_warm_apc0 {
				trip = <&skin_warm_trip>;
				cooling-device = <&CPU0 0 4>;
			};

			skin_warm_apc1 {
				trip = <&skin_warm_trip>;
				cooling-device = <&CPU6 0 5>;
			};

			skin_warm_gpu {
				trip = <&skin_warm_trip>;
				cooling-device = <&msm_gpu 0 2>;
			};

			skin_hot_apc0 {
				trip = <&skin_hot_trip>;
				cooling-device = <&CPU0 4 9>;
			};

			skin_hot_apc1 {
				trip = <&skin_hot_trip>;
				cooling-device = <&CPU6 5 10>;
			};

			skin_hot_gpu {
				trip = <&skin_hot_trip>;
				cooling-device = <&msm_gpu 2 5>;
			};

			skin_crit_apc0 {
				trip = <&skin_crit_trip>;
				cooling-device = <&CPU0 9 13>;
			};

			skin_crit_apc1 {
				trip = <&skin_crit_trip>;
				cooling-device = <&CPU6 10 14>;
			};

			skin_crit_gpu {
				trip = <&skin_crit_trip>;
				cooling-device = <&msm_gpu 5 9>;
			};
		};
	};

	/*
	 * The vendor AIDL thermal HAL reports its SKIN severities on this zone
	 * (sys-therm-2, pm8550_skin_therm, an ADC_TM channel) and the framework
	 * derives its global thermal status from SKIN alone. The HAL only
	 * refreshes a sensor when the kernel pushes a netlink event, which for
	 * an ADC_TM channel comes from the hardware window armed from these
	 * trips. Without trips in the 48-60 C band the severity never changes
	 * and stays at its boot-time value instead of tracking the skin
	 * temperature, so mirror the HAL severities below. No cooling-maps on
	 * purpose: this only drives event reporting, not mitigation.
	 */
	sys-therm-2 {
		/*
		 * The HAL only re-reads this zone on a netlink event and
		 * there is no cooling device to keep it polling, so poll it
		 * here: one sample per second keeps the whole ladder in
		 * sync.
		 */
		polling-delay = <1000>;

		trips {
			/*
			 * Baseline CRITICAL trip; keeps its gpu_dump_skip
			 * cooling-map. Its 10 C hysteresis left the
			 * CRITICAL -> SEVERE transition unreported down to
			 * 50 C.
			 */
			sys-therm2-config0 {
				hysteresis = <2000>;
			};

			/* HAL LIGHT, 48 C */
			skin-light {
				temperature = <48000>;
				hysteresis = <2000>;
				type = "passive";
			};

			/* HAL MODERATE, 49 C; 1 C gap, so a tighter window */
			skin-moderate {
				temperature = <49000>;
				hysteresis = <1000>;
				type = "passive";
			};

			/* HAL SEVERE, 50 C */
			skin-severe {
				temperature = <50000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};

};

&pm8550_flash0 {
	qcom,ires-ua = <5000>;
};

&pm8550_flash1 {
	qcom,ires-ua = <5000>;
};

&pm8550_flash2 {
	qcom,ires-ua = <5000>;
};

&pm8550_flash3 {
	qcom,ires-ua = <5000>;
};

&pm8550_torch0 {
	qcom,ires-ua = <5000>;
};

&pm8550_torch1 {
	qcom,ires-ua = <5000>;
};

&pm8550_torch2 {
	qcom,ires-ua = <5000>;
};

&pm8550_torch3 {
	qcom,ires-ua = <5000>;
};

&soc {
	//#ifdef OPLUS_FEATURE_THERMAL_HORAE
	shell_front {
		compatible = "oplus,shell-temp";
	};

	shell_frame {
		compatible = "oplus,shell-temp";
	};

	shell_back {
		compatible = "oplus,shell-temp";
	};
	//#endif /* OPLUS_FEATURE_THERMAL_HORAE */

};
